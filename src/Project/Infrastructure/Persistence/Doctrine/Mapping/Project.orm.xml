<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                          https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\Project\Domain\Entity\Project" table="projects" repository-class="App\Project\Infrastructure\Repository\ProjectRepository">
        <id name="id" type="integer">
            <generator strategy="IDENTITY"/>
        </id>

        <field name="title" type="string" length="255">
            <options>
                <option name="notnull">true</option>
            </options>
        </field>

        <field name="description" type="text" nullable="true"/>

        <many-to-one field="owner" target-entity="App\User\Domain\Entity\User" inversed-by="projects">
            <join-column name="owner_id" referenced-column-name="id" nullable="false"/>
        </many-to-one>

        <many-to-many field="members" target-entity="App\User\Domain\Entity\User">
            <join-table name="project_members">
                <join-columns>
                    <join-column name="project_id" referenced-column-name="id"/>
                </join-columns>
                <inverse-join-columns>
                    <join-column name="user_id" referenced-column-name="id"/>
                </inverse-join-columns>
            </join-table>
        </many-to-many>

        <one-to-many field="tasks" target-entity="App\Task\Domain\Entity\Task" mapped-by="project" orphan-removal="true">
            <cascade>
                <cascade-persist/>
                <cascade-remove/>
            </cascade>
        </one-to-many>

        <field name="createdAt" type="datetime_immutable">
            <options>
                <option name="notnull">true</option>
            </options>
        </field>

        <field name="updatedAt" type="datetime_immutable">
            <options>
                <option name="notnull">true</option>
            </options>
        </field>

        <lifecycle-callbacks>
            <lifecycle-callback type="preUpdate" method="updateTimestamps"/>
        </lifecycle-callbacks>
    </entity>

</doctrine-mapping>
