<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                          https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\Task\Domain\Entity\Task" table="tasks" repository-class="App\Task\Infrastructure\Repository\TaskRepository">
        <id name="id" type="integer">
            <generator strategy="IDENTITY"/>
        </id>

        <field name="title" type="string" length="255">
            <options>
                <option name="notnull">true</option>
            </options>
        </field>

        <field name="description" type="text" nullable="true"/>

        <field name="status" type="string" enum-type="App\Task\Domain\Enum\TaskStatus">
            <options>
                <option name="default">todo</option>
            </options>
        </field>

        <field name="type" type="string" enum-type="App\Task\Domain\Enum\TaskType">
            <options>
                <option name="default">task</option>
            </options>
        </field>

        <field name="priority" type="string" enum-type="App\Task\Domain\Enum\TaskPriority">
            <options>
                <option name="default">low</option>
            </options>
        </field>

        <many-to-one field="owner" target-entity="App\User\Domain\Entity\User" inversed-by="tasks">
            <join-column name="owner_id" referenced-column-name="id" nullable="false"/>
        </many-to-one>

        <many-to-one field="assignee" target-entity="App\User\Domain\Entity\User">
            <join-column name="assignee_id" referenced-column-name="id" nullable="true"/>
        </many-to-one>

        <many-to-one field="parent" target-entity="App\Task\Domain\Entity\Task" inversed-by="subtasks">
            <join-column name="parent_id" referenced-column-name="id" nullable="true"/>
        </many-to-one>

        <many-to-one field="project" target-entity="App\Project\Domain\Entity\Project" inversed-by="tasks">
            <join-column name="project_id" referenced-column-name="id" nullable="true"/>
        </many-to-one>

        <one-to-many field="subtasks" target-entity="App\Task\Domain\Entity\Task" mapped-by="parent" orphan-removal="true">
            <cascade>
                <cascade-persist/>
                <cascade-remove/>
            </cascade>
        </one-to-many>

        <one-to-many field="comments" target-entity="App\Comment\Domain\Entity\Comment" mapped-by="task" orphan-removal="true">
            <cascade>
                <cascade-persist/>
                <cascade-remove/>
            </cascade>
        </one-to-many>

        <field name="createdAt" type="datetime_immutable">
            <options>
                <option name="notnull">true</option>
            </options>
        </field>

        <field name="updatedAt" type="datetime_immutable">
            <options>
                <option name="notnull">true</option>
            </options>
        </field>

        <field name="dueDate" type="datetime_immutable" nullable="true"/>

        <lifecycle-callbacks>
            <lifecycle-callback type="preUpdate" method="updateTimestamps"/>
        </lifecycle-callbacks>
    </entity>

</doctrine-mapping>
